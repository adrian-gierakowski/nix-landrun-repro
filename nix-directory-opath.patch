+            auto link = makeFSSourceAccessor(tmpDir / name, trackLastModified, FinalSymlink::DontFollow);
+            EXPECT_THAT(link, HasSymlink(CanonPath::root, target));
+            if (trackLastModified)
+                EXPECT_GT(link->getLastModified(), 0);
+            else
+                EXPECT_EQ(link->getLastModified(), std::nullopt);
+        }
+    }
+    EXPECT_THAT(
+        makeFSSourceAccessor(tmpDir / "link", false, FinalSymlink::Follow), HasContents(CanonPath::root, "content"));
+    EXPECT_THAT(
