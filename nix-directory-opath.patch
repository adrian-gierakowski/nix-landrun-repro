+TEST_F(FSSourceAccessorTest, directoryWithoutReadPermission)
+{
+    writeFile(tmpDir / "file", "content");
+    createDirs(tmpDir / "subdir");
+    writeFile(tmpDir / "subdir" / "nested", "nested content");
+    createSymlink("file", tmpDir / "link");
+    createSymlink("subdir", tmpDir / "dirlink");
+    createSymlink("missing", tmpDir / "dangling");
+    createSymlink("loop", tmpDir / "loop");
+    auto restorePermissions =
+        Finally([&]() { std::filesystem::permissions(tmpDir, std::filesystem::perms::owner_all); });
+    std::filesystem::permissions(tmpDir, std::filesystem::perms::owner_exec);
+
+    if (openDirectory(tmpDir))
+        GTEST_SKIP() << "Directory read permissions are not enforced for this user";
+
+    auto accessor = makeFSSourceAccessor(tmpDir);
+    EXPECT_THAT(accessor, HasContents(CanonPath("file"), "content"));
+    EXPECT_THAT(accessor, HasContents(CanonPath("subdir/nested"), "nested content"));
+    EXPECT_THAT(accessor, HasSymlink(CanonPath("link"), "file"));
+    EXPECT_THAT(accessor, HasDirectory(CanonPath("subdir"), std::set<std::string>{"nested"}));
+    EXPECT_EQ(accessor->lstat(CanonPath::root).type, SourceAccessor::tDirectory);
+    EXPECT_THROW(accessor->readDirectory(CanonPath::root), SysError);
+
+    EXPECT_THAT(makeFSSourceAccessor(tmpDir / "file"), HasContents(CanonPath::root, "content"));
+    EXPECT_THAT(
+        makeFSSourceAccessor(tmpDir / "subdir"), HasDirectory(CanonPath::root, std::set<std::string>{"nested"}));
+    for (bool trackLastModified : {false, true}) {
